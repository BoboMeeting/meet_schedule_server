# 构建产物（镜像内重新生成）
**/bin/
**/obj/

# IDE / 系统
.vs/
.vscode/
.idea/
.git
.gitignore
*.user
*.suo
.DS_Store

# 本地开发配置（生产环境通过环境变量覆盖，不应进镜像）
appsettings.Development.json
appsettings.Local.json
appsettings.*.Development.json

# 测试与文档（镜像不需要）
tests/
TestResults/
**/*.md

# Docker 自身文件（避免递归）
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
.env
.env.*
