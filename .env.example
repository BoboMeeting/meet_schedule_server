# ============================================================================
# 部署配置模板：复制为 .env 后填入真实值，再 docker compose up -d --build
#   cp .env.example .env && nano .env
# 注意：.env 已在 .dockerignore 中排除，不会进入镜像
# ============================================================================

# 调度服务对外暴露端口（宿主机端口，容器内固定 5000）
SCHEDULER_PORT=5000

# JWT 签名共享密钥：生产环境必须改为高强度随机串，长度 >= 32 字节
# 生成示例：openssl rand -base64 48
# 重要：必须与管理平台(ManagerPlatform) .env 的 JWT_SECRET 完全一致
#   - 管理平台用它签发【服务 JWT】(aud=Service) 调用本服务内部接口
#   - App 用户 JWT 也由管理平台用同一密钥签发，本服务外部接口据此验签
AUTH_JWT_SECRET=change-me-to-32-bytes-or-longer-random-secret
# 以下两项须与管理平台 Jwt__Issuer / Jwt__Audience 一致（默认值已一致，一般无需修改）
JWT_ISSUER=BoboMeet.ManagerPlatform
JWT_AUDIENCE=BoboMeet.Client

# LiveKit 服务器配置（Bot 入会 / 服务端 API / Webhook 验签）
# LiveKit 跑在【宿主机】上时保持默认 host.docker.internal（容器内 localhost 指向容器自身）
# LiveKit 也容器化且在同一网络时，改为服务名，如 ws://livekit:7880
LIVEKIT_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
# 必须与 LiveKit 服务器 livekit.yaml 的 api_secret 完全一致；>=256 位（Webhook 验签必需）
# 另需在 livekit.yaml 的 webhook.urls 中配置本服务地址：
#   http://<宿主机IP>:5000/webhook/livekit（api_key 与 LIVEKIT_API_KEY 一致）
LIVEKIT_API_SECRET=change-me-to-256-bit-secret-matching-livekit-yaml

# 调度器
SCHEDULER_POLL_INTERVAL_SECONDS=1
SCHEDULER_BOT_IDENTITY_PREFIX=bot
